# Ein Addon-Ordner im Repo (Glimpse_Statistics/), alles andere liegt daneben. Der Packager baut im Ordner Glimpse_Statistics, schiebt den
# Inhalt des Addon-Ordners eine Ebene hoch; was außen liegt, bleibt über "ignore" draußen.
package-as: Glimpse_Statistics

move-folders:
  Glimpse_Statistics/Glimpse_Statistics: Glimpse_Statistics

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Beziehungen auf CurseForge (Kurznamen der Projekte); externe Addons werden nicht gemeldet
required-dependencies:
  - glimpse

embedded-libraries:
  - libdeflate

ignore:
  - tests
  - tools
  - docs
  - .github
  - .luacheckrc
  - .gitattributes
  - .gitignore
  - README.md
  - DEVELOPER.md
  - CHANGELOG.md
  - LICENSE
